{
  "id": "/?source=pwa",
  "name": "Zommy",
  "short_name": "Zommy",
  "description": "Save family memories quickly from your phone.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
